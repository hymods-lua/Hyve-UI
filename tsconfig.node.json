{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": false,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2020"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "target": "ES2020"
  },
  "include": [
    "vite.config.ts"
  ]
}